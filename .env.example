# Environment Variables
GROQ_API_KEY=gsk_            # From console.groq.com — required for all AI modules
GITHUB_TOKEN=ghp_...              # GitHub PAT — only needed for PR comment testing
PR_NUMBER=                        # PR number — set by CI automatically
CI=                               # Set to 'true' in CI to enable PR comment posting

# shopnode URLs (default for local dev)
SHOPNODE_API_URL=http://localhost:8000
SHOPNODE_UI_URL=http://localhost:3000

# QA Forge optional overrides
HEALING_ENABLED=false             # Set to 'true' to enable self-healing locators
HEALING_THRESHOLD=0.7             # Minimum confidence to apply a healed selector
FLAKE_THRESHOLD=0.2               # Flakiness score above which a test is flagged FLAKY
FLAKE_MIN_RUNS=5                  # Minimum runs required before scoring a test
AGENT_MAX_ERRORS=3                # Max errors before agent aborts with 'inconclusive'
