{
  "name": "qa-forge",
  "version": "1.0.0",
  "private": true,
  "description": "QA Forge Core Framework",
  "main": "dist/index.js",
  "bin": {
    "qa-forge": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "playwright test",
    "test:unit": "vitest run src/ai/__tests__",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "analyze:failures": "ts-node src/reporters/PRCommentPoster.ts",
    "detect:flakes": "ts-node src/ai/FlakeDetector.ts"
  },
  "dependencies": {
    "@langchain/core": "^0.2.0",
    "@langchain/langgraph": "^0.0.25",
    "@octokit/rest": "^20.1.1",
    "@pact-foundation/pact": "^13.0.0",
    "better-sqlite3": "^11.1.2",
    "dotenv": "^16.4.5",
    "groq-sdk": "^0.5.0",
    "prettier": "^3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.12",
    "allure-playwright": "^3.0.0-beta.7",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.4"
  }
}
